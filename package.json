{
  "name": "loja-salgados",
  "productName": "Sistema da Loja",
  "version": "0.1.0",
  "description": "PDV desktop para loja de salgados e produtos orientais: vendas, produtos, estoque, caixa e fiado.",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "teste": "node scripts/teste-servicos.cjs",
    "dist": "vite build && electron-builder --win"
  },
  "build": {
    "appId": "br.com.sistemaloja.pdv",
    "productName": "Sistema da Loja",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "sql.js": "^1.16.0"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "lucide-react": "^1.75.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "vite": "^8.3.8",
    "wait-on": "^9.5.1"
  }
}
